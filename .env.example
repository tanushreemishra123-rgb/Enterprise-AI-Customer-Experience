ENTERPRISE_TIMEOUT=4
LEGACY_TIMEOUT=4
MAX_RETRIES=1
MOCK_AUTH_MODE=normal
MOCK_LEGACY_MODE=success
MOCK_CASE_MODE=success
MOCK_BILLING_MODE=success
MOCK_GEMINI_MODE=success
